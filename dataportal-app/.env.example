# Backend API base URL (all PPI/STRING requests go through the backend)
# VITE_API_BASE_URL=http://localhost:8000/api

# Optional: STRING DB web base for links in the UI (API calls use the backend)
# VITE_STRING_DB_WEB_BASE=https://string-db.org

# Feature flags (default: false when unset). Set via Kubernetes ConfigMap for production.
# VITE_NETWORK_VIEW_ENABLED=true

# Other optional Vite env vars (see env.d.ts and constants.tsx):
# VITE_BACINTERACTOME_SHINY_APP_URL=
# VITE_ASSEMBLY_INDEXES_PATH=
# VITE_GFF_INDEXES_PATH=
# VITE_PFAM_URL= VITE_INTERPRO_URL= VITE_KEGG_URL= VITE_COG_URL= etc.
