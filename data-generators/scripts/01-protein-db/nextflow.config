params {
    batch = 'all'
    species_csv = "${projectDir}/../../data/reference/species.csv"
    hd_root = '/pub/databases/mett/annotations/v1_2024-04-15'
    hm_root = '/pub/databases/metagenomics/temp/mett/20hm/v1/annotations'
    hd_map = "${projectDir}/../../data/reference/gff-assembly-prefixes.tsv"
    hm_map = "${projectDir}/../../data/reference/gff-assembly-prefixes-20hm.tsv"
    faa_template = '{root}/{isolate}/functional_annotation/prokka/{isolate}.faa'
    manifest = ''
    skip_missing = false
    out = "${projectDir}/../../data/generated/protein-db"
}

manifest {
    name = 'mett-protein-db'
    description = 'Deduplicated METT protein database for PyHMMER'
    nextflowVersion = '>=22.10.0'
}

process {
    cpus = 1
    memory = '2 GB'
    withName: 'MERGE' {
        memory = '8 GB'
    }
}

profiles {
    hd {
        params.batch = 'hd'
    }
    '20hm' {
        params.batch = '20hm'
    }
    all {
        params.batch = 'all'
    }
}
